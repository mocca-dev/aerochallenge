{
  "name": "aerochallenge",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "react-scripts": "5.0.1",
    "react-transition-group": "^4.2.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "serve": "react-scripts build && serve -s build",
    "now-build": "react-scripts build && mv build dist",
    "deploy": "npm run build && npm run clean-map && cd build && surge -d https://aerochallenge.surge.sh && npm run play-finish-sound",
    "clean-map": "rimraf build/**/*.map",
    "play-finish-sound": "afplay /System/Library/Sounds/Glass.aiff",
    "postinstall": "patch-package"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "https://aerochallenge.ntoneko.vercel.app",
  "overrides": {
    "semver": "^7.6.0",
    "nth-check": "^2.1.0",
    "underscore": "^1.13.7",
    "svgo": "^2.8.0",
    "serialize-javascript": "^7.1.0",
    "postcss": "^8.4.32",
    "webpack-dev-server": "^5.2.1",
    "uuid": "^11.1.1",
    "@tootallnate/once": "^2.0.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
